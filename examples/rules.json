{
  "columns": {
    "subject_id": {"type": "text", "not_null": true, "pattern": "P\\d{4}"},
    "visit": {"type": "int", "min": 1, "max": 4},
    "sex": {"allowed": ["F", "M"]},
    "age": {"type": "int", "min": 18, "max": 90},
    "grip_force_n": {"type": "float", "min": 0, "max": 80},
    "visit_date": {"type": "date", "min": "2026-01-01"}
  },
  "unique": [["subject_id", "visit"]]
}
